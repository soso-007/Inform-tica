
COMANDOS DE JUNÇÃO (JOIN) EM SQL E COMANDOS UTILITÁRIOS PARA MANIPULAÇÃO DE DADOS.

INNER JOIN 

--1------------------------------------------------------

SELECT A.NOME AS ALUNO, T.NOME_TURMA FROM ALUNO A INNER JOIN TURMA T ON A.TURMA = T.CODIGO;

--2------------------------------------------------------

SELECT T.NOME_TURMA, COUNT(A.NOME) AS QUANTIDADE_ALUNOS FROM  TURMA T LEFT JOIN ALUNO A ON T.CODIGO = A.TURMA GROUP BY T.NOME_TURMA;

--3------------------------------------------------------

SELECT P.NOME AS PROFESSOR, D.DESCRICAO FROM PROFESSOR P RIGHT JOIN DISCIPLINA D ON P.CODIGO_DISCIPLINA = D.CODIGO_DISCIPLINA; 

--4-------------------------------------------------------

SELECT A.NOME AS ALUNO, T.NOME_TURMA FROM ALUNO A LEFT JOIN TURMA T ON A.TURMA = T.CODIGO AND A.IDADE >= 15

--5-------------------------------------------------------

SELECT D.DESCRICAO FROM  DISCIPLINA D RIGHT JOIN PROFESSOR P ON P.CODIGO_DISCIPLINA = D.CODIGO_DISCIPLINA WHERE P.CODIGO_DISCIPLINA IS NULL;



